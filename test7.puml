@startuml Диаграмма Классов

class Пользователь {
    String имя
    String почтовый_адрес
    String название_компании
    String номер_телефона
    String номер_факса
    String email
    просматривать_информацию_о_рейсах()
    зарегистрироваться()
}

class ЗарегистрированныйПользователь {
    бронировать_места(рейс, количество, список_пассажиров)
    отменить_бронирование(бронирование)
}

class Сотрудник {
    просматривать_рейсы()
    обновлять_информацию_о_рейсе(рейс)
}

class Рейс {
    String номер_рейса
    DateTime расписание
    int общие_места
    int доступные_места
    double стоимость_билета
    обновить_данные()
}

class Бронирование {
    int количество_мест
    DateTime дата_бронирования
    Status статус
    отправить_подтверждение_email()
    double рассчитать_возврат()
}

enum СтатусБронирования{
    ЗАБРОНИРОВАНО
    ОТМЕНЕНО
}

class Пассажир{
    String ФИО
    получить_информацию()
}

Пользователь <|-- ЗарегистрированныйПользователь
ЗарегистрированныйПользователь "1" --> "*" Бронирование : совершает
Бронирование "1" o-- "*" Пассажир : относится к
Бронирование "*" --> "1" Рейс : относится к
Сотрудник --> Рейс : управляет
СтатусБронирования -- Бронирование

@enduml