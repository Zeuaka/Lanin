@startuml
title Автоматические сценарии системы Умный дом
skinparam backgroundColor white
skinparam activityBackgroundColor #FEFECE
skinparam activityBorderColor black
skinparam activityDiamondBackgroundColor white
skinparam activityDiamondBorderColor black
|Сценарий 1: Датчик протечки|
start
:Срабатывание датчика протечки;
if (Автоматизация активна?) then (Да)
  :Отправить команду "Умному крану":\nперекрыть воду;
  :Сформировать уведомление;
  :Отправить уведомление на смартфон;
  :Записать событие в журнал;
else (Нет)
  :Записать событие в журнал;
endif
stop
|Сценарий 2: Датчик движения (Тревога)|
start
:Срабатывание датчика движения;
if (Статус дома:\n"Никого нет"?) then (Да)
  :Инициировать Сценарий Тревоги;
  fork
    :Начать запись с камер;
  fork again
    :Отправить уведомление\nна смартфон;
  fork again
    :Активировать мигание света;
  end fork
  :Записать событие в журнал;
else (Нет)
  :Игнорировать событие;
endif
stop
|Сценарий 3: Наружное освещение|
start
:Получить данные о времени/\nосвещенности;
if (Наступила темнота?) then (Да)
  :Включить наружное освещение;
  :Записать событие в журнал;
else (Нет)
  if (Наступил рассвет?) then (Да)
    :Выключить наружное освещение;
    :Записать событие в журнал;
  else (Нет)
    :Без действий;
  endif
endif
stop
|Сценарий 4: Управление климатом|
start
:Измерить текущую температуру;
if (Температура < заданной?) then (Да)
  :Включить обогреватель;
else (Нет)
  if (Температура > заданной?) then (Да)
    :Включить кондиционер;
  else (Нет)
    :Выключить климатическое\nоборудование;
  endif
endif
:Записать событие в журнал;
stop
@enduml